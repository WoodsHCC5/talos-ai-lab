# Copy to lab.env and fill in values from YOUR machine.
#   cp lab.env.example lab.env
#
# Discover disks after the node is in maintenance mode:
#   talosctl -n "$CONTROL_PLANE_IP" get disks -o yaml
# Discover a free LAN range for Cilium L2 announcements:
#   pick addresses your router will not hand out via DHCP

CLUSTER_NAME=lab
CONTROL_PLANE_IP=192.168.1.20
TALOS_VERSION=v1.13.8
KUBERNETES_VERSION=v1.36.0

# Where you sit and run talosctl / kubectl (this laptop), not the Talos box.
INSTALL_DISK=/dev/nvme0n1

# Unique, stable disk selectors. Serial is best. Do NOT use /dev/sda — names move.
# Leave the example strings in place until you replace them, then generate config.
DISK_SERIAL_LOCAL_PATH=REPLACE_HDD1_SERIAL
DISK_SERIAL_MODELS=REPLACE_HDD2_SERIAL

# Spare LAN addresses Cilium will ARP for LoadBalancer / Gateway.
# Need at least 2: one for the shared Gateway, extras for experiments.
LB_IP_POOL=192.168.1.50-192.168.1.59
GATEWAY_IP=192.168.1.50
GATEWAY_HOSTNAME=lab.home.arpa

# Public git remote Flux will reconcile. Set this after the GitHub repo exists.
GITHUB_OWNER=REPLACE_ME
GITHUB_REPO=talos-ai-lab
GITHUB_BRANCH=main
